# Copy this file to .env (never commit .env)

# How often to poll OpenSky for the selected region, in milliseconds.
# Anonymous access is rate-limited, so keep this at 60000 or higher.
VITE_POLL_INTERVAL_MS=60000

# Optional: override the API base URL (e.g. your own server-side proxy).
# Leave empty to use the defaults (Vite proxy in dev, OpenSky directly in prod).
# VITE_OPENSKY_BASE_URL=
